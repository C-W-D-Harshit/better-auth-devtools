{
  "name": "@better-auth-devtools/react",
  "version": "0.1.1-alpha.0",
  "private": false,
  "description": "Floating React panel for Better Auth DevTools with managed test user switching and session editing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Harshit",
  "homepage": "https://github.com/C-W-D-Harshit/better-auth-devtools#readme",
  "bugs": {
    "url": "https://github.com/C-W-D-Harshit/better-auth-devtools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C-W-D-Harshit/better-auth-devtools.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured'",
    "test": "pnpm exec vitest run"
  },
  "keywords": [
    "better-auth",
    "auth",
    "devtools",
    "react"
  ],
  "dependencies": {
    "@better-auth-devtools/core": "workspace:*",
    "@better-auth-devtools/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
