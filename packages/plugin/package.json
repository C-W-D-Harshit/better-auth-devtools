{
  "name": "@better-auth-devtools/plugin",
  "version": "0.1.1-alpha.0",
  "private": false,
  "description": "Better Auth DevTools server and client plugin for managed test users, session switching, and session inspection.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Harshit",
  "homepage": "https://github.com/C-W-D-Harshit/better-auth-devtools#readme",
  "bugs": {
    "url": "https://github.com/C-W-D-Harshit/better-auth-devtools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C-W-D-Harshit/better-auth-devtools.git",
    "directory": "packages/plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured'",
    "test": "pnpm exec vitest run"
  },
  "keywords": [
    "better-auth",
    "auth",
    "devtools",
    "plugin",
    "react"
  ],
  "dependencies": {
    "@better-auth-devtools/core": "workspace:*",
    "@better-auth-devtools/shared": "workspace:*"
  },
  "peerDependencies": {
    "better-auth": ">=1.2.0"
  },
  "devDependencies": {
    "better-auth": "^1.2.0",
    "typescript": "^5.8.0"
  }
}
