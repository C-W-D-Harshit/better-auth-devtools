{
  "name": "better-auth-devtools",
  "version": "0.1.1-alpha.7",
  "private": false,
  "description": "Unofficial Better Auth devtool for managed test users, session switching, and a React DevTools panel via plugin/react subpath exports.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "author": "Harshit",
  "homepage": "https://github.com/C-W-D-Harshit/better-auth-devtools#readme",
  "bugs": {
    "url": "https://github.com/C-W-D-Harshit/better-auth-devtools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C-W-D-Harshit/better-auth-devtools.git",
    "directory": "packages/plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured'",
    "test": "pnpm exec vitest run"
  },
  "keywords": [
    "better-auth",
    "auth",
    "devtools",
    "plugin",
    "react"
  ],
  "peerDependencies": {
    "better-auth": ">=1.2.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-auth": "^1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
